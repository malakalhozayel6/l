function trendSvg(points,empty='لا تتوفر تقييمات كافية للرسم البياني'){let valid=points.filter(x=>x.v!=null&&!Number.isNaN(x.v));if(!valid.length)return `<div class="empty">${empty}</div>`;let W=780,H=255,p={l:45,r:18,t:20,b:50},inner=W-p.l-p.r;
let coords=points.map((d,i)=>d.v==null?null:{x:p.l+(points.length===1?inner/2:i*inner/(points.length-1)),y:p.t+(100-d.v)*(H-p.t-p.b)/100,v:d.v,label:d.label});let line='';let segs=[];coords.forEach((p,i)=>{if(!p){if(line)segs.push(line);line='';return}line+=(line?' L':'M')+p.x+','+p.y});if(line)segs.push(line);let grid=[0,25,50,75,100].map(v=>{let y=p.t+(100-v)*(H-p.t-p.b)/100;return `<line class="gridline" x1="${p.l}" x2="${W-p.r}" y1="${y}" y2="${y}"/><text x="${p.l-8}" y="${y+4}" text-anchor="end">${v}</text>`}).join('');let labels=coords.map((c,i)=>{let x=p.l+(points.length===1?inner/2:i*inner/(points.length-1));return `<text x="${x}" y="${H-22}" text-anchor="middle">${E(points[i].label.length>13?points[i].label.slice(0,12)+'…':points[i].label)}</text>`}).join('');let circles=coords.filter(Boolean).map(c=>`<circle class="dot" cx="${c.x}" cy="${c.y}" r="5"><title>${E(c.label)}: ${fmt(c.v)}</title></circle><text x="${c.x}" y="${c.y-14}" text-anchor="middle" font-weight="800">${fmt(c.v)}</text>`).join('');return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="رسم بياني لدرجات التقييم من صفر إلى مئة">${grid}${segs.map(l=>`<path class="line" d="${l}"/>`).join('')}${circles}${labels}</svg>`}
function home(){let total=state.classes.reduce((n,c)=>n+c.students.length,0);let summary=state.classes.map(c=>`<article class="card classcard" role="button" tabindex="0" onclick="openClass('${c.id}')" onkeydown="if(event.key==='Enter')openClass('${c.id}')"><div class="kicker">الصف السابع</div><h3>${E(c.name)}</h3><p class="muted small">${c.students.length} طالبًا وطالبة</p><div style="display:flex;align-items:flex-end;justify-content:space-between;margin-top:21px"><div><span class="small muted">معدل الامتحان الشهري</span><div class="bigmetric">${fmt(scoreAverage(c.students.map(s=>s.baseline)))}</div></div><div class="pill">عرض الصف ←</div></div></article>`).join('');return `<section class="hero"><div class="herotxt"><div class="eyebrow">مدرسة التقوى الإعدادية · العلوم · 2026–2027</div><h1>خطوة نحو التقدّم<br>متابعة التحصيل العلمي</h1><p>مساحة تعليمية لتنظيم أهداف الطلاب، وتوثيق التقييمات، ومشاهدة تطوّر الأداء العلمي لكل طالب ولكل صف.</p><button class="btn" onclick="document.getElementById('classes').scrollIntoView({behavior:'smooth'})">استعراض الصفوف</button></div></section><div class="heading"><h2>نظرة عامة</h2><span class="hint">يتم تحديث الرسوم فور تسجيل أي تقييم</span></div><div class="stats"><div class="stat"><strong>3</strong><span>صفوف سابعة</span></div><div class="stat"><strong>${total}</strong><span>طالبًا وطالبة</span></div><div class="stat"><strong>${state.classes.reduce((n,c)=>n+c.students.reduce((m,s)=>m+s.tests.length,0),0)}</strong><span>تقييمات موثّقة</span></div><div class="stat"><strong>${state.classes.reduce((n,c)=>n+c.students.filter(s=>s.tests.length).length,0)}</strong><span>طلاب لديهم تقييمات جديدة</span></div></div><div id="classes" class="heading"><h2>صفوفي</h2></div><div class="cards">${summary}</div><div class="heading"><h2>الهدف من البرنامج</h2></div><div class="card"><p>متابعة الفروق الفردية دون اختزال مستوى الطالب في علامة واحدة، وتحويل نتائج الامتحانات إلى أهداف علمية محدّدة وإجراءات داعمة قابلة للتنفيذ والقياس.</p><p class="muted small">يعتمد خط الأساس على الامتحان الشهري المدرج في الملفات. أما التقييمات اللاحقة فيمكن تسجيلها بحسب أربعة مستويات، ثم مقارنة تطوّر أداء كل طالب والصف بصورة توضيحية.</p></div><div class="notice" style="margin-top:20px"><b>الخصوصية وحفظ العمل:</b> البيانات محفوظة محليًا في هذا المتصفح فقط، وليست على خادم. قبل تبديل الجهاز أو مسح بيانات المتصفح، استخدمي «نسخة احتياطية» واحفظي الملف في مكان آمن. لا ترفعي نسخة تحتوي أسماء الطلاب إلى استضافة عامة من دون نظام دخول وحماية.</div>`}
function classAvgPoints(c){let names=[...new Set(c.students.flatMap(s=>s.tests.map(t=>t.unit)))];names.sort((a,b)=>{let ta=c.students.flatMap(s=>s.tests).find(t=>t.unit===a);let tb=c.students.flatMap(s=>s.tests).find(t=>t.unit===b);return (ta?.date||'').localeCompare(tb?.date||'')});let pts=[{label:'الامتحان الشهري',v:scoreAverage(c.students.map(s=>s.baseline)),count:c.students.length}];for(const unit of names){const scores=c.students.map(s=>testsSorted(s).filter(t=>t.unit===unit).at(-1)?.total).filter(x=>x!==undefined);pts.push({label:unit,v:scoreAverage(scores),count:scores.length})}return pts}
function classPage(){const c=getClass();if(!c)return home();let current=scoreAverage(c.students.map(lastScore)),baseline=scoreAverage(c.students.map(s=>s.baseline));let pts=classAvgPoints(c);let active=c.students.filter(s=>s.tests.length).length;return `<div class="breadcrumb"><button onclick="goHome()">الرئيسية</button><span>/</span><b>${E(c.name)}</b></div><div class="heading" style="margin-top:0"><div><div class="kicker">الصف السابع</div><h1>صف ${E(c.name)}</h1></div><button class="subtle no-print" onclick="window.print()">طباعة ملخص الصف</button></div><div class="stats"><div class="stat"><strong>${c.students.length}</strong><span>عدد الطلاب</span></div><div class="stat"><strong>${fmt(baseline)}</strong><span>متوسط الامتحان الشهري</span></div><div class="stat"><strong>${fmt(current)}</strong><span>متوسط آخر نتيجة متاحة لكل طالب</span></div><div class="stat"><strong>${active}</strong><span>طلاب تم تقييمهم مجددًا</span></div></div><div class="split"><div class="card"><div class="sectiontitle">تطور متوسط الصف بحسب الوحدة</div><div class="chartbox">${trendSvg(pts)}</div><p class="hint">يُحسب متوسط كل وحدة من الطلاب الذين سُجّل لهم تقييم فيها فقط. عدد المشاركين: ${pts.map(p=>E(p.label)+' ('+p.count+')').join(' · ')}. عند نقص المشاركة لا يُعد تغيّر المتوسط دليلًا قاطعًا على تحسّن الصف.</p></div><div class="card"><div class="sectiontitle">الهدف التحصيلي للصف</div><p class="goalbar" id="classGoalText">${E(c.goal)}</p><button class="subtle no-print" onclick="editClassGoal()">تعديل هدف الصف</button><div style="margin-top:20px"><div class="sectiontitle">متابعة تنفيذ الخطة</div><p class="muted small">فحص قصير كل أسبوعين، مراجعة تقدّم المتعثرين، وتعديل المهام وفق أداء الفهم والتطبيق والتفسير.</p></div></div></div><div class="toolbar"><div class="right"><input class="input" style="min-width:235px" placeholder="ابحثي عن اسم الطالب..." value="${E(view.search)}" oninput="view.search=this.value;drawRows()"/><select id="filter" onchange="view.filter=this.value;drawRows()"><option value="all">جميع المستويات</option><option value="red">مستصعب</option><option value="orange">متمكن جزئيًا</option><option value="yellow">متمكن</option><option value="green">متمكن جدًا</option></select></div><div class="left"><span class="hint" id="resultCount"></span><button class="subtle" onclick="exportCSV()">تصدير جدول CSV</button></div></div><div class="tablewrap"><table><thead><tr><th>الطالب/ة</th><th>العلامة الأساسية</th><th>المستوى</th><th>المهارة المستهدفة</th><th>الهدف الفردي</th><th>آخر تقييم</th><th>التقدّم</th><th>الملف</th></tr></thead><tbody id="studentRows"></tbody></table></div>`}
function drawRows(){const c=getClass();if(!c)return;let q=view.search.trim().toLowerCase();let ss=c.students.filter(s=>(!q||s.name.toLowerCase().includes(q))&&(view.filter==='all'||level(s.baseline)[0]===view.filter));$('resultCount').textContent=ss.length+' من '+c.students.length+' طالبًا';$('studentRows').innerHTML=ss.map(s=>`<tr><td><button class="namebtn" onclick="openStudent('${s.id}')">${E(s.name)}</button></td><td><b>${fmt(s.baseline)}</b></td><td>${badge(s.baseline)}</td><td class="ellipsis">${E(s.skill)}</td><td class="ellipsis">${E(s.goal)}</td><td><b>${s.tests.length?fmt(lastScore(s)):'—'}</b></td><td>${s.tests.length?diff(lastScore(s),s.baseline):'—'}</td><td><button onclick="openStudent('${s.id}')">فتح التفاصيل</button></td></tr>`).join('')||'<tr><td class="empty" colspan="8">لا توجد نتائج مطابقة للبحث.</td></tr>';}
function studentPoints(s){return [{label:'الامتحان الشهري',v:s.baseline},...testsSorted(s).map(t=>({label:t.unit,v:t.total}))]}
function studentPage(){const c=getClass(),s=getStudent();if(!s)return classPage();let pts=studentPoints(s),latest=s.tests.length?lastScore(s):null;return `<div class="breadcrumb"><button onclick="goHome()">الرئيسية</button><span>/</span><button onclick="openClass('${c.id}')">${E(c.name)}</button><span>/</span><b>${E(s.name)}</b></div><div class="card"><div class="profiletop"><div><div class="kicker">ملف متابعة الطالب</div><h1>${E(s.name)}</h1><div style="display:flex;gap:8px;flex-wrap:wrap">${badge(s.baseline)}<span class="pill">العلامة الأساسية: ${fmt(s.baseline)}</span><span class="pill">${s.tests.length} تقييمات لاحقة</span></div></div><button class="primary no-print" onclick="document.getElementById('addTest').scrollIntoView({behavior:'smooth'})">إضافة تقييم جديد</button></div></div><div class="stats"><div class="stat"><strong>${fmt(s.baseline)}</strong><span>الامتحان الشهري</span></div><div class="stat"><strong>${latest==null?'—':fmt(latest)}</strong><span>آخر تقييم لاحق</span></div><div class="stat"><strong>${latest==null?'—':diff(latest,s.baseline)}</strong><span>الفرق عن خط الأساس</span></div><div class="stat"><strong>${s.tests.length}</strong><span>تقييمات مسجلة</span></div></div><div class="split"><div class="card"><div class="sectiontitle">منحنى تطوّر الطالب</div><div class="chartbox">${trendSvg(pts)}</div><p class="hint">الاختبار الشهري نقطة البداية. المقارنة بين اختبارات ذات وحدات وصعوبات مختلفة إشارة متابعة وليست مقياسًا نهائيًا للتحسّن.</p></div><div class="card"><div class="sectiontitle">خطة الطالب الفردية</div><div class="panelrow"><strong>المهارة العلمية المستهدفة</strong><span id="vskill">${E(s.skill)}</span></div><div class="panelrow"><strong>الهدف</strong><span id="vgoal">${E(s.goal)}</span></div><div class="panelrow"><strong>إجراءات الوصول للهدف</strong><span id="vsteps">${E(s.steps)}</span></div><div class="panelrow"><strong>آلية المتابعة</strong><span id="vfollow">${E(s.follow)}</span></div><button class="subtle no-print" onclick="editStudentPlan()">تعديل الخطة الفردية</button></div></div><div class="split" style="margin-top:17px"><div class="card" id="addTest"><div class="sectiontitle">إضافة اختبار نهاية فصل / وحدة</div><p class="muted small">أدخلي العلامة المحققة من أصل 25 في كل مستوى؛ المجموع النهائي من 100. اختاري وحدات متقاربة في مستوى الصعوبة حتى تكون المقارنة أكثر عدلًا.</p><div class="inlinegrid"><label class="field">اسم الوحدة / الفصل<input id="unit" class="input" placeholder="مثلًا: حالات المادة" maxlength="80"/></label><label class="field">تاريخ الاختبار<input id="testDate" class="input" type="date" value="${new Date().toISOString().slice(0,10)}"/></label></div><div class="formgrid"><label class="leveltab"><span class="label">المستوى الأول</span><small>تذكّر المعرفة</small><input type="number" id="n1" class="input" min="0" max="25" step="1" value="0" oninput="updateTotal()"/></label><label class="leveltab"><span class="label">المستوى الثاني</span><small>فهم وتفسير أساسي</small><input type="number" id="n2" class="input" min="0" max="25" step="1" value="0" oninput="updateTotal()"/></label><label class="leveltab"><span class="label">المستوى الثالث</span><small>تطبيق ومقارنة</small><input type="number" id="n3" class="input" min="0" max="25" step="1" value="0" oninput="updateTotal()"/></label><label class="leveltab"><span class="label">المستوى الرابع</span><small>استنتاج وتعليل</small><input type="number" id="n4" class="input" min="0" max="25" step="1" value="0" oninput="updateTotal()"/></label></div><div class="inlinegrid" style="align-items:center"><div><span class="muted small">المجموع</span><div class="result-total"><span id="total">0</span><span class="muted" style="font-size:13px"> / 100</span></div></div><button class="primary" onclick="addTest()">حفظ نتيجة الاختبار</button></div></div><div class="card"><div class="sectiontitle">ملاحظات ومتابعة الطالب</div><p class="muted small">مساحة خاصة لتوثيق ملاحظاتك الجديدة، ما نجح معه، والخطوات القادمة.</p><textarea id="studentNotes" placeholder="اكتبي ملاحظات عن التفاعل، الفهم، التركيز، أو التقدم...">${E(s.notes)}</textarea><div class="toolbar"><span class="hint">تُحفظ الملاحظة عند الضغط على الزر</span><button class="primary" onclick="saveNotes()">حفظ الملاحظات</button></div><div class="sectiontitle" style="margin-top:22px">قراءة نتائج المستويات</div><div id="levelInsight">${levelInsight(s)}</div></div></div><div class="card" style="margin-top:17px"><div class="sectiontitle">سجل التقييمات</div>${s.tests.length?`<ul class="tests">${testsSorted(s).reverse().map(t=>`<li><div><strong>${E(t.unit)}</strong><span class="muted small"> · ${E(t.date)} · ${t.scores.map(fmt).join(' / ')}</span></div><div style="display:flex;align-items:center;gap:12px"><strong>${fmt(t.total)}/100</strong><button class="danger no-print" onclick="deleteTest('${E(t.id)}')">حذف</button></div></li>`).join('')}</ul>`:'<div class="empty">لا توجد اختبارات إضافية حتى الآن. ابدئي بتسجيل أول اختبار.</div>'}</div>`}
function levelInsight(s){let a=testsSorted(s).at(-1);if(!a)return '<div class="muted small">بعد أول اختبار، سيظهر هنا المستوى الأقوى والمستوى الذي يحتاج إلى دعم.</div>';let names=['تذكّر المعرفة','الفهم الأساسي','التطبيق والمقارنة','الاستنتاج والتعليل'];let min=Math.min(...a.scores),max=Math.max(...a.scores);let low=names[a.scores.indexOf(min)],high=names[a.scores.indexOf(max)];return `<div class="goalbar">أقوى جانب في آخر تقييم: <b>${E(high)}</b> (${max}/25).<br>الأولوية التدريبية القادمة: <b>${E(low)}</b> (${min}/25).<br><span class="muted small">هذا اقتراح آلي مبني على نتائج الاختبار، ويُراجع مع الملاحظات الصفية.</span></div>`}
function updateTotal(){let n=[1,2,3,4].map(i=>Number($('n'+i).value||0));$('total').textContent=n.reduce((a,b)=>a+b,0)}
function addTest(){const s=getStudent(),unit=$('unit').value.trim(),date=$('testDate').value,arr=[1,2,3,4].map(i=>Number($('n'+i).value));if(!unit||!date)return alert('أدخلي اسم الوحدة وتاريخ الاختبار.');if(arr.some(n=>!Number.isInteger(n)||n<0||n>25))return alert('كل مستوى يجب أن يكون عددًا صحيحًا بين 0 و25.');if(s.tests.some(t=>t.unit===unit&&t.date===date)&&!confirm('يوجد تقييم للوحدة في التاريخ نفسه. هل تريدين إضافة تقييم آخر؟'))return;s.tests.push({id:Date.now()+'-'+Math.random().toString(36).slice(2,7),unit,date,scores:arr,total:arr.reduce((a,b)=>a+b,0),created:new Date().toISOString()});save();render()}
function deleteTest(id){if(!confirm('هل تريدين حذف هذا التقييم؟ لا يمكن استعادته إلا من نسخة احتياطية.'))return;let s=getStudent();s.tests=s.tests.filter(t=>t.id!==id);save();render()}
function saveNotes(){const s=getStudent();s.notes=$('studentNotes').value;save();toast('حُفظت ملاحظات الطالب')}
function modal(title,fields,onSave){$('modalTitle').textContent=title;$('modalFields').innerHTML=fields;$('modalBack').style.display='flex';$('modalSave').onclick=()=>{if(onSave()!==false){$('modalBack').style.display='none';save();render()}}}
function editClassGoal(){const c=getClass();modal('تعديل الهدف التحصيلي للصف',`<label class="field">الهدف<textarea id="goalEdit">${E(c.goal)}</textarea></label>`,()=>{if(!$('goalEdit').value.trim())return false;c.goal=$('goalEdit').value.trim()})}
function editStudentPlan(){const s=getStudent();let fields=[['skill','المهارة المستهدفة'],['goal','الهدف الفردي'],['steps','إجراءات الوصول إلى الهدف'],['follow','آلية المتابعة']];modal('تعديل الخطة الفردية',fields.map(([id,label])=>`<label class="field">${label}<textarea id="edit_${id}">${E(s[id])}</textarea></label>`).join(''),()=>{fields.forEach(([id])=>s[id]=$('edit_'+id).value.trim())})}
function closeModal(){$('modalBack').style.display='none'}
function openClass(id){view={page:'class',classId:id,studentId:null,search:'',filter:'all'};render();window.scrollTo(0,0)}
function openStudent(id){view.studentId=id;view.page='student';render();window.scrollTo(0,0)}
function goHome(){view={page:'home',classId:null,studentId:null,search:'',filter:'all'};render();window.scrollTo(0,0)}
function render(){$('app').innerHTML=view.page==='home'?home():view.page==='class'?classPage():studentPage();if(view.page==='class'){const el=$('filter');if(el)el.value=view.filter;drawRows()}document.title=(view.page==='home'?'خطوة نحو التقدّم':view.page==='class'?getClass().name:getStudent().name)+' | متابعة العلوم'}
function download(name,blob){let a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1500)}
function backup(){const stamp=new Date().toISOString().slice(0,10);download('نسخة-احتياطية-متابعة-العلوم-'+stamp+'.json',new Blob([JSON.stringify({type:'science-tracker-backup',exportedAt:new Date().toISOString(),data:state},null,2)],{type:'application/json'}));toast('تم إنشاء نسخة احتياطية')}
function restoreFile(input){let f=input.files?.[0];if(!f)return;f.text().then(txt=>{let x=JSON.parse(txt),data=x.type==='science-tracker-backup'?x.data:x;if(!data.classes||!Array.isArray(data.classes)||data.classes.length!==3||!data.classes.every(c=>Array.isArray(c.students)))throw Error('ملف غير متوافق');if(!confirm('سيؤدي الاستيراد إلى استبدال جميع التغييرات المحلية الحالية. هل تريدين المتابعة؟'))return;state=data;save();goHome()}).catch(e=>alert('تعذّرت استعادة الملف: '+e.message)).finally(()=>input.value='')}
function exportCSV(){let c=getClass();const rows=[['الطالب/ة','العلامة الأساسية','المستوى','المهارة','الهدف','آخر تقييم','التغيّر','عدد التقييمات','الملاحظات'],...c.students.map(s=>[s.name,s.baseline,level(s.baseline)[1],s.skill,s.goal,s.tests.length?lastScore(s):'',s.tests.length?lastScore(s)-s.baseline:'',s.tests.length,s.notes])];let csv='\uFEFF'+rows.map(r=>r.map(x=>'"'+String(x??'').replace(/"/g,'""')+'"').join(',')).join('\r\n');download('متابعة-'+c.name+'.csv',new Blob([csv],{type:'text/csv;charset=utf-8'}))}
window.addEventListener('beforeunload',e=>{if(unsaved){e.preventDefault();e.returnValue=''}});
render();</script></body></html>